{
  "name": "tm-barcode-qrcode-generator",
  "description": "Barcode and QR code generator, that works offline",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "",
  "author": "Mikkel Albrechtsen",
  "scripts": {
    "dev": "vite",
    "dev-host": "vite --host",
    "build": "tsc && vite build",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal public/vite.svg",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "html2canvas": "^1.4.1",
    "i18next": "^24.2.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-modal": "^3.16.3",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react-swc": "^4.3",
    "autoprefixer": "^10.6",
    "eslint": "^9.7",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1",
    "eslint-plugin-react-refresh": "^0.5",
    "postcss": "^8.4.49",
    "react-barcode": "^1.5.3",
    "react-dom": "^18.3.0",
    "react-i18next": "^15.3.0",
    "react-icons": "^5.4.0",
    "react-modal": "^3.16.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
